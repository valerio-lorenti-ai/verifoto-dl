ENVIRONMENT=development
INTERNAL_API_KEY=
MODEL_VERSION=pico_plus_exp3_aug
THRESHOLD=0.1
MAX_FILE_SIZE_MB=10

# Cloudflare R2 — model storage
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ACCOUNT_ID=
R2_BUCKET_NAME=verifoto-models
R2_MODEL_KEY=best.pt

# MODEL_PATH:
#   Local dev  → api/weights/best.pt   (cwd = repo root)
#   Railway    → weights/best.pt       (WORKDIR = /app inside container)
MODEL_PATH=api/weights/best.pt
